.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --panel-bg: rgba(12, 16, 24, 0.88);
    --panel-border: rgb(150, 125, 70);
    --text: rgb(235, 235, 228);
    --text-dim: rgb(150, 155, 162);
    --gold: rgb(255, 205, 70);
    --health: rgb(70, 200, 90);
    --mana: rgb(60, 130, 235);
    --xp: rgb(175, 115, 245);
    --ally: rgb(70, 150, 255);
    --enemy: rgb(235, 70, 60);
    --self: rgb(90, 225, 90);
    --track: rgb(24, 26, 32);
    color: var(--text);
}

.hidden {
    display: none;
}

.panel {
    background-color: var(--panel-bg);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: 6px;
}

/* ---------- World-space overlays ---------- */

.world-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.unit-bar {
    position: absolute;
    transform-origin: center bottom;
    width: 36px;
    height: 6px;
    translate: -50% -100%;
    background-color: rgba(0, 0, 0, 0.75);
    border-width: 1px;
    border-color: rgb(0, 0, 0);
}

.unit-bar--hero {
    width: 84px;
    height: 9px;
}

.unit-bar--tower {
    width: 100px;
    height: 8px;
}

.unit-bar--core {
    width: 130px;
    height: 9px;
}

.unit-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--enemy);
}

.unit-bar--ally > .unit-bar__fill {
    background-color: var(--ally);
}

.unit-bar--self > .unit-bar__fill {
    background-color: var(--self);
}

.unit-bar--protected {
    opacity: 0.5;
}

.unit-bar__level {
    position: absolute;
    left: -22px;
    top: -5px;
    width: 19px;
    height: 17px;
    padding: 0;
    margin: 0;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgb(20, 20, 28);
    border-width: 1px;
    border-color: var(--gold);
    color: var(--text);
}

.floating-text {
    position: absolute;
    transform-origin: center bottom;
    translate: -50% -100%;
    padding: 0;
    margin: 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--gold);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.floating-text--xp {
    font-size: 14px;
    color: var(--xp);
}

/* ---------- Top stats ---------- */

.top-bar {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.stats-panel {
    flex-direction: row;
    transform-origin: center top;
    padding: 6px 14px;
}

.stat {
    margin: 0 10px;
    padding: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text);
}

.stat--gold {
    color: var(--gold);
}

.stat--time {
    color: var(--text-dim);
}

/* ---------- Hero panel ---------- */

.bottom-bar {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.hero-panel {
    flex-direction: row;
    transform-origin: center bottom;
    align-items: center;
    padding: 12px 14px 10px 14px;
}

.hero-panel--dead {
    opacity: 0.6;
}

.portrait {
    width: 96px;
    height: 96px;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    border-radius: 48px;
    border-width: 3px;
    border-color: var(--gold);
    background-color: rgb(60, 48, 22);
}

.portrait__initial {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--gold);
}

.portrait__level {
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: 34px;
    height: 34px;
    padding: 0;
    margin: 0;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 17px;
    border-width: 2px;
    border-color: var(--gold);
    background-color: rgb(20, 20, 28);
    color: var(--text);
}

.portrait__skill-points {
    position: absolute;
    left: -6px;
    top: -6px;
    width: 34px;
    height: 24px;
    padding: 0;
    margin: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 6px;
    background-color: rgb(60, 170, 70);
    color: rgb(255, 255, 255);
}

.ability-bar {
    flex-direction: row;
    margin-bottom: 6px;
}

.ability-slot-container {
    margin: 0 4px;
}

.ability-slot {
    align-items: center;
}

.ability-slot__frame {
    width: 64px;
    height: 64px;
    overflow: hidden;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(90, 90, 100);
    background-color: rgb(30, 34, 44);
}

.ability-slot__frame:hover {
    border-color: rgb(220, 220, 220);
}

.ability-slot__icon {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.ability-slot__cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0.72);
}

.ability-slot__cooldown-text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.ability-slot__key {
    position: absolute;
    left: 4px;
    top: 2px;
    padding: 0;
    margin: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.ability-slot__cost {
    position: absolute;
    right: 4px;
    bottom: 2px;
    padding: 0;
    margin: 0;
    font-size: 13px;
    color: rgb(140, 190, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.ability-slot__pips {
    flex-direction: row;
    height: 6px;
    margin-top: 4px;
}

.pip {
    width: 9px;
    height: 4px;
    margin: 0 1px;
    background-color: rgb(60, 60, 70);
}

.pip--filled {
    background-color: var(--gold);
}

.ability-slot__level-up {
    display: none;
    position: absolute;
    left: 18px;
    top: -30px;
    width: 28px;
    height: 24px;
    padding: 0;
    margin: 0;
    font-size: 18px;
    -unity-font-style: bold;
    border-width: 1px;
    border-radius: 5px;
    border-color: rgb(30, 90, 35);
    background-color: rgb(60, 170, 70);
    color: rgb(255, 255, 255);
}

.ability-slot__level-up:hover {
    background-color: rgb(85, 200, 95);
}

.ability-slot--can-level > .ability-slot__level-up {
    display: flex;
}

.ability-slot--empty > .ability-slot__frame {
    border-color: rgb(55, 55, 62);
    background-color: rgb(18, 20, 26);
}

.ability-slot--empty > .ability-slot__frame > .ability-slot__key {
    color: var(--text-dim);
}

.ability-slot--ready > .ability-slot__frame {
    border-color: var(--gold);
}

.ability-slot--unlearned > .ability-slot__frame > .ability-slot__icon {
    -unity-background-image-tint-color: rgb(80, 80, 80);
}

.ability-slot--no-mana > .ability-slot__frame > .ability-slot__icon {
    -unity-background-image-tint-color: rgb(90, 120, 220);
}

.ability-slot--targeting > .ability-slot__frame {
    border-color: rgb(120, 220, 255);
}

.resource-bar {
    height: 20px;
    margin-top: 3px;
    overflow: hidden;
    border-radius: 3px;
    background-color: var(--track);
}

.resource-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.resource-bar--health > .resource-bar__fill {
    background-color: var(--health);
}

.resource-bar--mana > .resource-bar__fill {
    background-color: var(--mana);
}

.resource-bar__text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.xp-bar {
    height: 5px;
    margin-top: 4px;
    background-color: var(--track);
}

.xp-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--xp);
}

/* ---------- Minimap ---------- */

.minimap-frame {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 250px;
    height: 250px;
    padding: 4px;
}

.minimap {
    flex-grow: 1;
    background-color: rgb(34, 54, 32);
}

/* ---------- Tooltip, hints, overlays ---------- */

.tooltip {
    position: absolute;
    transform-origin: center bottom;
    left: 50%;
    bottom: 200px;
    width: 340px;
    translate: -50% 0;
    padding: 10px 12px;
}

.tooltip__title {
    padding: 0;
    margin: 0 0 4px 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--gold);
}

.tooltip__stats {
    padding: 0;
    margin: 0 0 6px 0;
    font-size: 12px;
    color: var(--text-dim);
    white-space: normal;
}

.tooltip__body {
    padding: 0;
    margin: 0;
    font-size: 13px;
    white-space: normal;
}

.targeting-hint {
    position: absolute;
    transform-origin: center bottom;
    left: 0;
    right: 0;
    bottom: 205px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(150, 225, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.respawn-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(230, 230, 230);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.game-over {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.game-over__title {
    margin-bottom: 24px;
    font-size: 96px;
    -unity-font-style: bold;
    color: var(--text);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.game-over--victory > .game-over__title {
    color: var(--self);
}

.game-over--defeat > .game-over__title {
    color: var(--enemy);
}

.game-over__button {
    width: 220px;
    height: 52px;
    font-size: 22px;
    -unity-font-style: bold;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--panel-border);
    background-color: var(--panel-bg);
    color: var(--gold);
}

.game-over__button:hover {
    background-color: rgb(40, 46, 60);
}

.menu-button {
    position: absolute;
    top: 12px;
    right: 12px;
    height: 34px;
    padding: 0 14px;
    margin: 0;
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--panel-border);
    background-color: var(--panel-bg);
    color: var(--gold);
}

.menu-button:hover {
    background-color: rgb(40, 46, 60);
}

/* ---------- Cheat menu ---------- */

.cheats {
    position: absolute;
    top: 58px;
    right: 12px;
    width: 170px;
    padding: 6px;
    transform-origin: right top;
}

.cheats__header {
    height: 26px;
    padding: 0 6px;
    margin: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--gold);
}

.cheats__body {
    margin-top: 4px;
}

.cheats--collapsed > .cheats__body {
    display: none;
}

.cheats__button {
    height: 30px;
    padding: 0 8px;
    margin: 0 0 4px 0;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(55, 60, 72);
    background-color: rgb(24, 28, 38);
    color: var(--text);
}

.cheats__button:hover {
    border-color: var(--gold);
}

.cheats__button:disabled {
    opacity: 0.45;
}

.cheats__toggle--on {
    border-color: rgb(90, 170, 90);
    background-color: rgb(30, 60, 34);
    color: rgb(170, 240, 170);
}

/* ---------- Inventory ---------- */

.inventory {
    align-self: stretch;
    justify-content: space-between;
    margin-left: 14px;
}

.inventory__grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 200px;
}

.item-slot {
    width: 46px;
    height: 46px;
    margin: 2px;
    overflow: hidden;
    border-width: 2px;
    border-radius: 5px;
    border-color: rgb(70, 72, 84);
    background-color: rgb(20, 22, 28);
}

.item-slot:hover {
    border-color: rgb(220, 220, 220);
}

.item-slot--filled {
    border-color: rgb(130, 115, 75);
}

.item-slot--drag-source {
    opacity: 0.35;
}

.item-slot--drop-target {
    border-color: rgb(120, 220, 255);
}

.item-slot__icon {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.item-slot__glyph {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.inventory__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
    padding: 0 2px;
}

.inventory__gold {
    padding: 0;
    margin: 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--gold);
}

.inventory__shop-button {
    height: 26px;
    padding: 0 12px;
    margin: 0;
    font-size: 14px;
    -unity-font-style: bold;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--panel-border);
    background-color: rgb(40, 34, 20);
    color: var(--gold);
}

.inventory__shop-button:hover {
    background-color: rgb(60, 50, 25);
}

.item-ghost {
    position: absolute;
    left: 0;
    top: 0;
    width: 46px;
    height: 46px;
    overflow: hidden;
    opacity: 0.85;
    border-width: 2px;
    border-radius: 5px;
    border-color: var(--gold);
}

/* ---------- Shop ---------- */

.shop {
    position: absolute;
    left: 24px;
    top: 70px;
    width: 430px;
    height: 560px;
    padding: 14px 16px;
    transform-origin: left top;
}

.shop__header {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
}

.shop__title {
    padding: 0;
    margin: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--gold);
}

.shop__close {
    height: 28px;
    padding: 0 12px;
    margin: 0;
    font-size: 13px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(80, 85, 100);
    background-color: rgb(30, 36, 48);
    color: var(--text);
}

.shop__status {
    flex-shrink: 0;
    padding: 0;
    margin: 6px 0 8px 0;
    font-size: 13px;
    white-space: normal;
    color: rgb(140, 220, 140);
}

.shop__status--locked {
    color: rgb(240, 150, 90);
}

.shop__list {
    flex-grow: 1;
    flex-basis: 0;
}

.shop-item {
    flex-direction: row;
    align-items: center;
    height: 60px;
    padding: 6px;
    margin-bottom: 4px;
    border-width: 1px;
    border-radius: 5px;
    border-color: rgb(55, 60, 72);
    background-color: rgb(24, 28, 38);
}

.shop-item:hover {
    border-color: var(--gold);
}

.shop-item--unavailable {
    opacity: 0.55;
}

.shop-item__tile {
    width: 44px;
    height: 44px;
    margin-right: 10px;
    overflow: hidden;
    border-radius: 5px;
}

.shop-item__info {
    flex-grow: 1;
}

.shop-item__name {
    padding: 0;
    margin: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text);
}

.shop-item__stats {
    padding: 0;
    margin: 0;
    font-size: 12px;
    color: rgb(140, 220, 140);
}

.shop-item__cost {
    padding: 0;
    margin: 0 4px 0 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--gold);
}

.shop-item--unaffordable > .shop-item__cost {
    color: rgb(210, 90, 80);
}

.shop__hint {
    flex-shrink: 0;
    padding: 0;
    margin: 8px 0 0 0;
    font-size: 12px;
    white-space: normal;
    color: var(--text-dim);
}

/* ---------- Spell slot: mod sockets, glyph, drop target ---------- */

.ability-slot__sockets {
    flex-direction: row;
    justify-content: center;
    height: 16px;
    margin-bottom: 3px;
}

.mod-socket {
    width: 12px;
    height: 12px;
    margin: 2px 3px;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(110, 110, 120);
    background-color: rgb(20, 22, 28);
}

.mod-socket:hover {
    border-color: rgb(235, 235, 235);
}

.mod-socket--filled {
    border-color: rgb(150, 115, 30);
    background-color: var(--gold);
}

.mod-socket--inactive {
    border-color: rgb(120, 50, 45);
    background-color: rgb(170, 70, 60);
}

.ability-slot__glyph {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.ability-slot--drop-target > .ability-slot__frame {
    border-color: rgb(120, 220, 255);
}

.ability-slot--unlearned > .ability-slot__frame > .ability-slot__glyph {
    color: rgb(150, 150, 150);
}

/* ---------- Shop sections, HUD messages ---------- */

.shop__section {
    margin: 10px 0 4px 2px;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--gold);
}

.hud-message {
    position: absolute;
    left: 0;
    right: 0;
    transform-origin: center bottom;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 190, 120);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.unit-bar--burning {
    border-color: rgb(255, 140, 30);
}

.minimap__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.unit-bar--stunned {
    border-width: 2px;
    border-color: rgb(255, 230, 80);
}

/* Isolated enemy hero (the local hero's isolation passive deals bonus damage to it). */
.unit-bar--isolated {
    border-width: 2px;
    border-color: rgb(200, 90, 255);
}

.portrait:hover {
    border-color: rgb(255, 235, 150);
}

/* ---------- Scoreboard (hold Tab) ---------- */

.scoreboard {
    position: absolute;
    top: 90px;
    left: 50%;
    width: 980px;
    translate: -50% 0;
    padding: 14px 18px 16px 18px;
    transform-origin: center top;
}

.scoreboard__header {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 8px;
}

.scoreboard__kills {
    width: 80px;
    padding: 0;
    margin: 0;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.scoreboard__kills--ally {
    color: var(--ally);
}

.scoreboard__kills--enemy {
    color: var(--enemy);
}

.scoreboard__time {
    width: 110px;
    padding: 0;
    margin: 0;
    font-size: 18px;
    -unity-text-align: middle-center;
    color: var(--text-dim);
}

.scoreboard__team {
    padding: 0;
    margin: 10px 0 4px 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.scoreboard__team--ally {
    color: var(--ally);
}

.scoreboard__team--enemy {
    color: var(--enemy);
}

.score-row {
    flex-direction: row;
    align-items: center;
    height: 58px;
    padding: 0 8px;
    margin-bottom: 4px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgb(40, 45, 56);
    background-color: rgba(24, 28, 38, 0.9);
}

.score-row--labels {
    height: 22px;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.score-row--self {
    border-color: var(--gold);
}

.score-row--dead {
    opacity: 0.6;
}

.score-col {
    padding: 0;
    margin: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-dim);
    -unity-text-align: middle-center;
}

.score-col--hero {
    width: 230px;
    -unity-text-align: middle-left;
}

.score-col--level {
    width: 50px;
}

.score-col--kda {
    width: 110px;
}

.score-col--cs {
    width: 60px;
}

.score-col--spells {
    width: 180px;
}

.score-col--items {
    flex-grow: 1;
}

.score-cell {
    padding: 0;
    margin: 0;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text);
}

.score-hero {
    width: 230px;
    flex-direction: row;
    align-items: center;
}

.score-portrait {
    width: 42px;
    height: 42px;
    margin-right: 10px;
    border-radius: 21px;
    border-width: 2px;
    border-color: rgb(20, 22, 28);
    align-items: center;
    justify-content: center;
}

.score-portrait__glyph {
    padding: 0;
    margin: 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.score-portrait__respawn {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    border-radius: 21px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.7);
    color: rgb(240, 110, 100);
}

.score-hero__name {
    padding: 0;
    margin: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text);
}

.score-hero__player {
    padding: 0;
    margin: 0;
    font-size: 12px;
    color: var(--text-dim);
}

.score-spells {
    width: 180px;
    flex-direction: row;
    justify-content: center;
}

.score-spell {
    width: 40px;
    margin: 0 2px;
    align-items: center;
}

.score-tile {
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 5px;
    border-color: rgb(55, 60, 72);
    background-color: rgb(18, 21, 28);
}

.score-tile--spell {
    width: 36px;
    height: 36px;
}

.score-tile--item {
    width: 32px;
    height: 32px;
    margin-right: 4px;
}

.score-tile__glyph {
    padding: 0;
    margin: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.score-sockets {
    flex-direction: row;
    height: 7px;
    margin-top: 2px;
}

.score-socket {
    width: 6px;
    height: 6px;
    margin: 0 1px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(110, 115, 125);
}

.score-socket--filled {
    border-color: var(--gold);
    background-color: var(--gold);
}

.score-items {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

/* ---------- Ascension choice (levels 6 / 11 / 18) ---------- */

.ascension {
    position: absolute;
    top: 150px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    transform-origin: center top;
    --path-a: rgb(80, 200, 210);
    --path-b: rgb(185, 120, 255);
}

.ascension__title {
    padding: 0;
    margin: 0;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--gold);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.ascension__subtitle {
    padding: 0;
    margin: 2px 0 12px 0;
    font-size: 16px;
    color: var(--text);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.ascension__cards {
    flex-direction: row;
}

.ascension-card {
    width: 330px;
    height: 430px;
    margin: 0 10px;
    padding: 16px 20px;
    align-items: center;
    border-width: 3px;
    border-radius: 10px;
    border-color: var(--panel-border);
    background-color: rgba(12, 16, 24, 0.96);
}

.ascension-card:hover {
    border-color: var(--gold);
    background-color: rgba(30, 28, 20, 0.95);
    scale: 1.03 1.03;
}

.ascension-card__badge {
    padding: 2px 10px;
    margin: 0 0 12px 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-radius: 4px;
    color: rgb(12, 16, 24);
}

.ascension-card--a .ascension-card__badge {
    background-color: var(--path-a);
}

.ascension-card--b .ascension-card__badge {
    background-color: var(--path-b);
}

.ascension-card__glyph {
    width: 84px;
    height: 84px;
    padding: 0;
    margin: 0 0 12px 0;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 3px;
    border-radius: 42px;
    background-color: rgb(20, 24, 34);
    color: var(--text);
}

.ascension-card--a .ascension-card__glyph {
    border-color: var(--path-a);
    color: var(--path-a);
}

.ascension-card--b .ascension-card__glyph {
    border-color: var(--path-b);
    color: var(--path-b);
}

.ascension-card__name {
    padding: 0;
    margin: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--gold);
}

.ascension-card__path {
    padding: 0;
    margin: 2px 0 0 0;
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--text-dim);
}

.ascension-card__effects {
    align-self: stretch;
    margin-top: 14px;
    padding-top: 12px;
    border-top-width: 1px;
    border-color: rgb(60, 66, 80);
}

.ascension-card__effect {
    padding: 0;
    margin: 0 0 4px 0;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(140, 220, 140);
}

.ascension-card__flavor {
    padding: 0;
    margin: 10px 0 0 0;
    font-size: 14px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--text-dim);
}

.ascension-card__hint {
    padding: 0;
    margin: 0;
    font-size: 13px;
    color: var(--text-dim);
}

.ascension-card:hover .ascension-card__hint {
    color: var(--gold);
}
