<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Hud.uss" />
    <ui:Template name="AbilitySlot" src="AbilitySlot.uxml" />
    <ui:VisualElement name="hudRoot" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="worldLayer" class="world-layer" picking-mode="Ignore" />

        <ui:VisualElement name="topBar" class="top-bar" picking-mode="Ignore">
            <ui:VisualElement name="statsPanel" class="panel stats-panel">
                <ui:Label name="goldLabel" class="stat stat--gold" text="0g" />
                <ui:Label name="csLabel" class="stat" text="CS 0" />
                <ui:Label name="kdaLabel" class="stat" text="0 / 0" />
                <ui:Label name="timeLabel" class="stat stat--time" text="00:00" />
                <ui:Label name="waveLabel" class="stat" text="Next wave 0" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="bottomBar" class="bottom-bar" picking-mode="Ignore">
            <ui:VisualElement name="heroPanel" class="panel hero-panel">
                <ui:VisualElement name="portrait" class="portrait">
                    <ui:Label name="portraitInitial" class="portrait__initial" text="H" picking-mode="Ignore" />
                    <ui:Label name="levelLabel" class="portrait__level" text="1" picking-mode="Ignore" />
                    <ui:Label name="skillPointsLabel" class="portrait__skill-points" text="+1" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="heroMain" class="hero-main">
                    <ui:VisualElement name="abilityBar" class="ability-bar">
                        <ui:Instance template="AbilitySlot" name="slotQ" class="ability-slot-container" />
                        <ui:Instance template="AbilitySlot" name="slotW" class="ability-slot-container" />
                        <ui:Instance template="AbilitySlot" name="slotE" class="ability-slot-container" />
                        <ui:Instance template="AbilitySlot" name="slotR" class="ability-slot-container" />
                    </ui:VisualElement>
                    <ui:VisualElement name="healthBar" class="resource-bar resource-bar--health">
                        <ui:VisualElement name="fill" class="resource-bar__fill" />
                        <ui:Label name="text" class="resource-bar__text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="manaBar" class="resource-bar resource-bar--mana">
                        <ui:VisualElement name="fill" class="resource-bar__fill" />
                        <ui:Label name="text" class="resource-bar__text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="xpBar" class="xp-bar">
                        <ui:VisualElement name="fill" class="xp-bar__fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="inventoryPanel" class="inventory">
                    <ui:VisualElement name="inventoryGrid" class="inventory__grid" />
                    <ui:VisualElement class="inventory__footer">
                        <ui:Label name="inventoryGold" class="inventory__gold" text="0g" picking-mode="Ignore" />
                        <ui:Button name="shopButton" class="inventory__shop-button" text="Shop" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="minimapFrame" class="panel minimap-frame" />

        <ui:Button name="menuButton" class="menu-button" text="Options" />

        <ui:VisualElement name="cheatPanel" class="panel cheats">
            <ui:Button name="cheatHeader" class="cheats__header" text="Cheats [-]" />
            <ui:VisualElement name="cheatBody" class="cheats__body">
                <ui:Button name="cheatLevel" class="cheats__button" text="+1 level" />
                <ui:Button name="cheatGold" class="cheats__button" text="+10000 gold" />
                <ui:Button name="cheatMana" class="cheats__button cheats__toggle" text="No mana cost" />
                <ui:Button name="cheatCooldowns" class="cheats__button cheats__toggle" text="No cooldowns" />
                <ui:Button name="cheatSpeed" class="cheats__button cheats__toggle" text="Game speed: 1x" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="shopWindow" class="panel shop hidden">
            <ui:VisualElement class="shop__header">
                <ui:Label class="shop__title" text="Shop" />
                <ui:Button name="shopClose" class="shop__close" text="Close" />
            </ui:VisualElement>
            <ui:Label name="shopStatus" class="shop__status" />
            <ui:ScrollView name="shopList" class="shop__list" />
            <ui:Label name="shopHint" class="shop__hint" />
        </ui:VisualElement>

        <ui:VisualElement name="scoreboard" class="panel scoreboard hidden" picking-mode="Ignore">
            <ui:VisualElement class="scoreboard__header" picking-mode="Ignore">
                <ui:Label name="scoreAllyKills" class="scoreboard__kills scoreboard__kills--ally" text="0" picking-mode="Ignore" />
                <ui:Label name="scoreTime" class="scoreboard__time" text="00:00" picking-mode="Ignore" />
                <ui:Label name="scoreEnemyKills" class="scoreboard__kills scoreboard__kills--enemy" text="0" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="score-row score-row--labels" picking-mode="Ignore">
                <ui:Label class="score-col score-col--hero" text="HERO" picking-mode="Ignore" />
                <ui:Label class="score-col score-col--level" text="LVL" picking-mode="Ignore" />
                <ui:Label class="score-col score-col--kda" text="K / D / A" picking-mode="Ignore" />
                <ui:Label class="score-col score-col--cs" text="CS" picking-mode="Ignore" />
                <ui:Label class="score-col score-col--spells" text="SPELLS" picking-mode="Ignore" />
                <ui:Label class="score-col score-col--items" text="ITEMS" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label class="scoreboard__team scoreboard__team--ally" text="YOUR TEAM" picking-mode="Ignore" />
            <ui:VisualElement name="scoreAllyRows" picking-mode="Ignore" />
            <ui:Label class="scoreboard__team scoreboard__team--enemy" text="ENEMY TEAM" picking-mode="Ignore" />
            <ui:VisualElement name="scoreEnemyRows" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="tooltip" class="panel tooltip hidden" picking-mode="Ignore">
            <ui:Label name="tooltipTitle" class="tooltip__title" picking-mode="Ignore" />
            <ui:Label name="tooltipStats" class="tooltip__stats" picking-mode="Ignore" />
            <ui:Label name="tooltipBody" class="tooltip__body" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:Label name="targetingHint" class="targeting-hint hidden" picking-mode="Ignore" />
        <ui:Label name="hudMessage" class="hud-message hidden" picking-mode="Ignore" />
        <ui:Label name="respawnLabel" class="respawn-label hidden" picking-mode="Ignore" />

        <ui:VisualElement name="gameOverOverlay" class="game-over hidden">
            <ui:Label name="gameOverTitle" class="game-over__title" text="VICTORY" />
            <ui:Button name="restartButton" class="game-over__button" text="Play again" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
