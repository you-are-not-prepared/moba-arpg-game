.frontend {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(12, 15, 22);
    --gold: rgb(255, 205, 70);
    --text: rgb(235, 235, 228);
    --text-dim: rgb(150, 155, 162);
    --panel: rgb(20, 25, 35);
    --border: rgb(60, 66, 80);
    --accent-border: rgb(150, 125, 70);
    --ally: rgb(70, 130, 220);
    --enemy: rgb(210, 80, 70);
    color: var(--text);
}

.hidden {
    display: none;
}

.screen {
    flex-grow: 1;
}

/* ---------- Buttons ---------- */

.fe-button {
    height: 48px;
    padding: 0 28px;
    margin: 0;
    font-size: 18px;
    -unity-font-style: bold;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--border);
    background-color: var(--panel);
    color: var(--text);
}

.fe-button:hover {
    border-color: var(--gold);
}

.fe-button:disabled {
    opacity: 0.4;
}

.fe-button--primary {
    border-color: var(--accent-border);
    background-color: rgb(50, 42, 20);
    color: var(--gold);
}

.fe-button--primary:hover {
    background-color: rgb(70, 58, 26);
}

/* ---------- Start screen ---------- */

.start {
    align-items: center;
    justify-content: center;
}

.start__title {
    padding: 0;
    margin: 0;
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--gold);
}

.start__subtitle {
    padding: 0;
    margin: 4px 0 48px 0;
    font-size: 20px;
    color: var(--text-dim);
}

.start__menu {
    align-items: center;
}

.start__button {
    width: 260px;
    margin-bottom: 14px;
}

.mode__heading {
    padding: 0;
    margin: 0 0 20px 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--text);
}

.mode__row {
    flex-direction: row;
    margin-bottom: 28px;
}

.mode-card {
    width: 340px;
    min-height: 170px;
    margin: 0 12px;
    padding: 22px 24px;
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--border);
    background-color: var(--panel);
}

.mode-card:hover {
    border-color: var(--gold);
    background-color: rgb(32, 30, 24);
}

.mode-card__title {
    padding: 0;
    margin: 0 0 10px 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--gold);
}

.mode-card__text {
    padding: 0;
    margin: 0;
    font-size: 15px;
    white-space: normal;
    color: var(--text-dim);
}

/* ---------- Champion select ---------- */

.select {
    padding: 40px 56px;
}

.select__header {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 24px;
}

.select__heading {
    flex-shrink: 1;
}

.select__title {
    padding: 0;
    margin: 0;
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--gold);
}

.select__mode {
    padding: 0;
    margin: 6px 0 0 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text);
}

.select__subtitle {
    padding: 0;
    margin: 4px 0 0 0;
    font-size: 16px;
    color: var(--text-dim);
}

.map-card {
    flex-direction: row;
    flex-shrink: 0;
    width: 520px;
    padding: 14px;
    border-width: 2px;
    border-radius: 8px;
    border-color: var(--accent-border);
    background-color: var(--panel);
}

.map-card__preview {
    width: 140px;
    height: 140px;
    flex-shrink: 0;
    margin-right: 16px;
    border-radius: 6px;
    background-color: rgb(34, 54, 32);
}

.map-card__info {
    flex-grow: 1;
    flex-shrink: 1;
}

.map-card__label {
    padding: 0;
    margin: 0 0 4px 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--text-dim);
}

.map-card__name {
    padding: 0;
    margin: 0 0 6px 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text);
}

.map-card__description {
    padding: 0;
    margin: 0;
    font-size: 14px;
    white-space: normal;
    color: var(--text-dim);
}

.select__body {
    flex-direction: row;
    flex-grow: 1;
    align-items: flex-start;
}

/* ---------- Team columns ---------- */

.team-column {
    width: 300px;
    flex-shrink: 0;
}

.team-column__label {
    padding: 0;
    margin: 0 0 10px 0;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.team-column__label--ally {
    color: var(--ally);
}

.team-column__label--enemy {
    color: var(--enemy);
}

.team-slot {
    flex-direction: row;
    align-items: center;
    height: 80px;
    padding: 0 12px;
    margin-bottom: 10px;
    border-width: 2px;
    border-left-width: 6px;
    border-radius: 8px;
    border-color: var(--border);
    background-color: var(--panel);
}

.team-slot--ally {
    border-left-color: var(--ally);
}

.team-slot--enemy {
    border-left-color: var(--enemy);
}

.team-slot--local {
    border-color: var(--gold);
    background-color: rgb(32, 30, 24);
}

.team-slot--open {
    opacity: 0.5;
}

.team-slot__glyph {
    width: 54px;
    height: 54px;
    margin-right: 14px;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 27px;
    border-width: 2px;
    border-color: rgb(20, 22, 28);
    background-color: rgb(45, 50, 62);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.team-slot__who {
    padding: 0;
    margin: 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--text-dim);
}

.team-slot__hero {
    padding: 0;
    margin: 2px 0 0 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--text);
}

.team-slot__hero--pending {
    -unity-font-style: italic;
    color: var(--text-dim);
}

/* ---------- Hero grid + details ---------- */

.select__center {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    margin: 0 32px;
}

.hero-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.hero-tile {
    width: 136px;
    height: 156px;
    margin: 0 6px 12px 6px;
    padding: 12px 6px;
    align-items: center;
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--border);
    background-color: var(--panel);
}

.hero-tile:hover {
    border-color: rgb(140, 140, 150);
}

.hero-tile--selected {
    border-color: var(--gold);
    background-color: rgb(32, 30, 24);
}

.hero-tile--selected:hover {
    border-color: var(--gold);
}

.hero-tile--taken {
    opacity: 0.35;
}

.hero-tile--taken:hover {
    border-color: var(--border);
}

.hero-tile__glyph {
    width: 76px;
    height: 76px;
    padding: 0;
    margin: 0 0 8px 0;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 38px;
    border-width: 3px;
    border-color: rgb(20, 22, 28);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hero-tile__name {
    padding: 0;
    margin: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text);
}

.hero-tile__note {
    padding: 0;
    margin: 0;
    font-size: 12px;
    color: var(--text-dim);
}

.hero-detail {
    width: 100%;
    max-width: 820px;
    margin-top: 6px;
    padding: 20px 24px;
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--border);
    background-color: var(--panel);
}

.hero-detail__top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.hero-detail__glyph {
    width: 64px;
    height: 64px;
    margin-right: 16px;
    padding: 0;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 32px;
    border-width: 3px;
    border-color: rgb(20, 22, 28);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hero-detail__name {
    padding: 0;
    margin: 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--text);
}

.hero-detail__title {
    padding: 0;
    margin: 0;
    font-size: 15px;
    color: var(--text-dim);
}

.hero-detail__stats {
    padding: 0;
    margin: 0 0 6px 0;
    font-size: 14px;
    color: var(--text-dim);
}

.hero-detail__text {
    padding: 0;
    margin: 0;
    font-size: 15px;
    white-space: normal;
    color: var(--text);
}

.hero-detail__abilities {
    flex-direction: row;
    margin-top: 14px;
}

.hero-detail__ability {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 18px;
}

.hero-detail__section {
    padding: 0;
    margin: 0 0 2px 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--gold);
}

.hero-detail__ability-name {
    padding: 0;
    margin: 0 0 2px 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--text);
}

.hero-detail__empty {
    padding: 0;
    margin: 0;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: var(--text-dim);
}

/* ---------- Footer ---------- */

.select__footer {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    margin-top: 20px;
}

.select__status {
    flex-grow: 1;
    padding: 0;
    margin: 0 24px;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: var(--text-dim);
}
