.frontend {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(12, 15, 22);
    --gold: rgb(255, 205, 70);
    --text: rgb(235, 235, 228);
    --text-dim: rgb(150, 155, 162);
    --panel: rgb(20, 25, 35);
    --border: rgb(60, 66, 80);
    --accent-border: rgb(150, 125, 70);
    --ally: rgb(70, 130, 220);
    --enemy: rgb(210, 80, 70);
    color: var(--text);
}

.hidden {
    display: none;
}

.screen {
    flex-grow: 1;
}

/* ---------- Buttons ---------- */

.fe-button {
    height: 48px;
    padding: 0 28px;
    margin: 0;
    font-size: 18px;
    -unity-font-style: bold;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--border);
    background-color: var(--panel);
    color: var(--text);
}

.fe-button:hover {
    border-color: var(--gold);
}

.fe-button:disabled {
    opacity: 0.4;
}

.fe-button--primary {
    border-color: var(--accent-border);
    background-color: rgb(50, 42, 20);
    color: var(--gold);
}

.fe-button--primary:hover {
    background-color: rgb(70, 58, 26);
}

/* ---------- Start screen ---------- */

.start {
    align-items: center;
    justify-content: center;
}

.start__title {
    padding: 0;
    margin: 0;
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--gold);
}

.start__subtitle {
    padding: 0;
    margin: 4px 0 48px 0;
    font-size: 20px;
    color: var(--text-dim);
}

.start__menu {
    align-items: center;
}

.start__button {
    width: 260px;
    margin-bottom: 14px;
}

.mode__heading {
    padding: 0;
    margin: 0 0 20px 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--text);
}

.mode__row {
    flex-direction: row;
    margin-bottom: 28px;
}

.mode-card {
    width: 340px;
    min-height: 170px;
    margin: 0 12px;
    padding: 22px 24px;
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--border);
    background-color: var(--panel);
}

.mode-card:hover {
    border-color: var(--gold);
    background-color: rgb(32, 30, 24);
}

.mode-card__title {
    padding: 0;
    margin: 0 0 10px 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--gold);
}

.mode-card__text {
    padding: 0;
    margin: 0;
    font-size: 15px;
    white-space: normal;
    color: var(--text-dim);
}

/* ---------- Login ---------- */

.login-card {
    width: 460px;
    padding: 26px 32px 18px 32px;
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--border);
    background-color: var(--panel);
}

.login__heading {
    padding: 0;
    margin: 0 0 8px 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text);
}

.login__label {
    padding: 0;
    margin: 12px 0 5px 0;
    font-size: 14px;
    color: var(--text-dim);
}

.login__field {
    height: 44px;
    margin: 0;
    --unity-cursor-color: rgb(255, 205, 70);
}

.login__field > .unity-base-text-field__input {
    padding: 0 12px;
    font-size: 17px;
    -unity-text-align: middle-left;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--border);
    background-color: rgb(12, 15, 22);
    color: var(--text);
}

.login__field:focus > .unity-base-text-field__input {
    border-color: var(--gold);
}

.login__message {
    padding: 0;
    margin: 14px 0 0 0;
    font-size: 14px;
    white-space: normal;
    color: rgb(240, 115, 100);
}

.login__message--info {
    color: var(--text-dim);
}

.login__submit {
    margin-top: 20px;
}

.login__link {
    align-self: center;
    margin: 12px 0 0 0;
    padding: 4px 8px;
    font-size: 14px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-dim);
}

.login__link:hover {
    color: var(--gold);
}

.login__offline {
    margin-top: 22px;
}

.account-bar {
    position: absolute;
    top: 24px;
    right: 32px;
    flex-direction: row;
    align-items: center;
}

.account-bar__label {
    padding: 0;
    margin: 0;
    font-size: 15px;
    color: var(--text-dim);
}

.account-bar__button {
    margin: 0 0 0 10px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--border);
}

/* ---------- Champion select ---------- */

.select {
    padding: 40px 56px;
}

.select__header {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 24px;
}

.select__heading {
    flex-shrink: 1;
}

.select__title {
    padding: 0;
    margin: 0;
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--gold);
}

.select__mode {
    padding: 0;
    margin: 6px 0 0 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text);
}

.select__subtitle {
    padding: 0;
    margin: 4px 0 0 0;
    font-size: 16px;
    color: var(--text-dim);
}

.map-card {
    flex-direction: row;
    flex-shrink: 0;
    width: 520px;
    padding: 14px;
    border-width: 2px;
    border-radius: 8px;
    border-color: var(--accent-border);
    background-color: var(--panel);
}

.map-card__preview {
    width: 140px;
    height: 140px;
    flex-shrink: 0;
    margin-right: 16px;
    border-radius: 6px;
    background-color: rgb(34, 54, 32);
}

.map-card__info {
    flex-grow: 1;
    flex-shrink: 1;
}

.map-card__label {
    padding: 0;
    margin: 0 0 4px 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--text-dim);
}

.map-card__name {
    padding: 0;
    margin: 0 0 6px 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text);
}

.map-card__description {
    padding: 0;
    margin: 0;
    font-size: 14px;
    white-space: normal;
    color: var(--text-dim);
}

.select__body {
    flex-direction: row;
    flex-grow: 1;
    align-items: flex-start;
}

/* ---------- Team columns ---------- */

.team-column {
    width: 300px;
    flex-shrink: 0;
}

.team-column__label {
    padding: 0;
    margin: 0 0 10px 0;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.team-column__label--ally {
    color: var(--ally);
}

.team-column__label--enemy {
    color: var(--enemy);
}

.team-slot {
    flex-direction: row;
    align-items: center;
    height: 80px;
    padding: 0 12px;
    margin-bottom: 10px;
    border-width: 2px;
    border-left-width: 6px;
    border-radius: 8px;
    border-color: var(--border);
    background-color: var(--panel);
}

.team-slot--ally {
    border-left-color: var(--ally);
}

.team-slot--enemy {
    border-left-color: var(--enemy);
}

.team-slot--local {
    border-color: var(--gold);
    background-color: rgb(32, 30, 24);
}

.team-slot--open {
    opacity: 0.5;
}

.team-slot__glyph {
    width: 54px;
    height: 54px;
    margin-right: 14px;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 27px;
    border-width: 2px;
    border-color: rgb(20, 22, 28);
    background-color: rgb(45, 50, 62);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.team-slot__who {
    padding: 0;
    margin: 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--text-dim);
}

.team-slot__hero {
    padding: 0;
    margin: 2px 0 0 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--text);
}

.team-slot__hero--pending {
    -unity-font-style: italic;
    color: var(--text-dim);
}

/* ---------- Hero grid + details ---------- */

.select__center {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    margin: 0 32px;
}

.hero-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.hero-tile {
    width: 136px;
    height: 156px;
    margin: 0 6px 12px 6px;
    padding: 12px 6px;
    align-items: center;
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--border);
    background-color: var(--panel);
}

.hero-tile:hover {
    border-color: rgb(140, 140, 150);
}

.hero-tile--selected {
    border-color: var(--gold);
    background-color: rgb(32, 30, 24);
}

.hero-tile--selected:hover {
    border-color: var(--gold);
}

.hero-tile--taken {
    opacity: 0.35;
}

.hero-tile--taken:hover {
    border-color: var(--border);
}

.hero-tile__glyph {
    width: 76px;
    height: 76px;
    padding: 0;
    margin: 0 0 8px 0;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 38px;
    border-width: 3px;
    border-color: rgb(20, 22, 28);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hero-tile__name {
    padding: 0;
    margin: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text);
}

.hero-tile__note {
    padding: 0;
    margin: 0;
    font-size: 12px;
    color: var(--text-dim);
}

.hero-detail {
    width: 100%;
    max-width: 820px;
    margin-top: 6px;
    padding: 20px 24px;
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--border);
    background-color: var(--panel);
}

.hero-detail__top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.hero-detail__glyph {
    width: 64px;
    height: 64px;
    margin-right: 16px;
    padding: 0;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 32px;
    border-width: 3px;
    border-color: rgb(20, 22, 28);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hero-detail__name {
    padding: 0;
    margin: 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--text);
}

.hero-detail__title {
    padding: 0;
    margin: 0;
    font-size: 15px;
    color: var(--text-dim);
}

.hero-detail__stats {
    padding: 0;
    margin: 0 0 6px 0;
    font-size: 14px;
    color: var(--text-dim);
}

.hero-detail__text {
    padding: 0;
    margin: 0;
    font-size: 15px;
    white-space: normal;
    color: var(--text);
}

.hero-detail__abilities {
    flex-direction: row;
    margin-top: 14px;
}

.hero-detail__ability {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 18px;
}

.hero-detail__section {
    padding: 0;
    margin: 0 0 2px 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--gold);
}

.hero-detail__ability-name {
    padding: 0;
    margin: 0 0 2px 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--text);
}

.hero-detail__empty {
    padding: 0;
    margin: 0;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: var(--text-dim);
}

/* ---------- Footer ---------- */

.select__footer {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    margin-top: 20px;
}

.select__status {
    flex-grow: 1;
    padding: 0;
    margin: 0 24px;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: var(--text-dim);
}

.select__start-now {
    margin-right: 12px;
}

/* ---------- Match history ---------- */

.history {
    padding: 40px 56px;
}

.history__header {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 20px;
}

.history__summary {
    padding: 0;
    margin: 8px 0 0 0;
    font-size: 17px;
    white-space: normal;
    color: var(--text);
}

.history__status {
    padding: 0;
    margin: 40px 0 0 0;
    font-size: 17px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--text-dim);
}

.history__list {
    flex-grow: 1;
}

.history-row {
    flex-direction: row;
    align-items: center;
    height: 76px;
    padding: 0 18px;
    margin-bottom: 8px;
    border-width: 2px;
    border-left-width: 8px;
    border-radius: 8px;
    border-color: var(--border);
    background-color: var(--panel);
}

.history-row--win {
    border-left-color: rgb(80, 190, 110);
}

.history-row--loss {
    border-left-color: rgb(210, 80, 70);
}

.history-row__result {
    width: 150px;
}

.history-row__outcome {
    padding: 0;
    margin: 0;
    font-size: 19px;
    -unity-font-style: bold;
}

.history-row--win .history-row__outcome {
    color: rgb(110, 215, 135);
}

.history-row--loss .history-row__outcome {
    color: rgb(235, 110, 100);
}

.history-row__small {
    padding: 0;
    margin: 2px 0 0 0;
    font-size: 13px;
    color: var(--text-dim);
}

.history-row__hero {
    width: 220px;
    flex-direction: row;
    align-items: center;
}

.history-glyph {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    padding: 0;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgb(20, 22, 28);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.history-row__name {
    padding: 0;
    margin: 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--text);
}

.history-row__stat {
    width: 140px;
}

.history-row__big {
    padding: 0;
    margin: 0;
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--text);
}

.history-row__teams {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.history-mini {
    width: 30px;
    height: 30px;
    margin: 0 2px;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 15px;
    border-width: 2px;
    border-color: rgb(20, 22, 28);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.history-mini--you {
    border-color: var(--gold);
}

.history-row__vs {
    padding: 0;
    margin: 0 10px;
    font-size: 13px;
    color: var(--text-dim);
}

.history-row__when {
    width: 140px;
    align-items: flex-end;
}

.history-tag {
    padding: 1px 6px;
    margin: 4px 0 0 0;
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 4px;
    background-color: rgb(90, 60, 20);
    color: var(--gold);
}

/* ---------- Match details (expanded history entry) ---------- */

.history-entry {
    margin-bottom: 8px;
}

.history-entry > .history-row {
    margin-bottom: 0;
}

.history-row:hover {
    border-color: rgb(110, 115, 128);
}

.history-row--open {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.history-row__toggle {
    width: 28px;
    padding: 0;
    margin: 0 0 0 10px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text-dim);
}

.match-details {
    padding: 10px 18px 14px 26px;
    border-width: 0 2px 2px 2px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-color: var(--border);
    background-color: rgb(16, 20, 28);
}

.match-details__status {
    padding: 0;
    margin: 8px 0 0 0;
    font-size: 14px;
    color: var(--text-dim);
}

.match-details__team {
    padding: 0;
    margin: 10px 0 4px 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.match-details__team--win {
    color: rgb(110, 215, 135);
}

.match-details__team--loss {
    color: rgb(235, 110, 100);
}

.details-row {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    padding: 4px 8px;
    margin-bottom: 3px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgb(40, 45, 56);
    background-color: var(--panel);
}

.details-row--labels {
    min-height: 20px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.details-row--me {
    border-color: var(--gold);
}

.details-col {
    padding: 0;
    margin: 0;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: var(--text-dim);
}

.details-col--player {
    width: 220px;
    -unity-text-align: middle-left;
}

.details-col--kda {
    width: 100px;
}

.details-col--cs {
    width: 50px;
}

.details-col--damage {
    width: 140px;
    margin-right: 10px;
}

.details-col--total {
    width: 100px;
}

.details-col--spells {
    width: 180px;
}

.details-col--items {
    flex-grow: 1;
}

.details-player {
    flex-direction: row;
    align-items: center;
}

.details-player .history-mini {
    margin-right: 10px;
}

.details-player__hero {
    padding: 0;
    margin: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text);
}

.details-player__name {
    padding: 0;
    margin: 0;
    font-size: 12px;
    color: var(--text-dim);
}

.details-cell {
    padding: 0;
    margin: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text);
}

.details-bar {
    height: 24px;
    justify-content: center;
    border-radius: 4px;
    background-color: rgb(26, 30, 40);
    overflow: hidden;
}

.details-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
}

.details-bar--damage {
    background-color: rgb(170, 70, 55);
}

.details-bar--taken {
    background-color: rgb(70, 95, 150);
}

.details-bar__value {
    padding: 0 8px;
    margin: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.details-tiles {
    flex-direction: row;
    align-items: flex-start;
}

.details-spell {
    align-items: center;
    margin-right: 6px;
}

.details-mods {
    flex-direction: row;
    margin-top: 2px;
}

.details-tile {
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(55, 60, 72);
    background-color: rgb(18, 21, 28);
}

.details-tile--spell {
    width: 34px;
    height: 34px;
}

.details-tile--mod {
    width: 14px;
    height: 14px;
    margin: 0 1px;
    border-radius: 2px;
}

.details-tile--item {
    width: 30px;
    height: 30px;
    margin-right: 4px;
}

.details-tile__glyph {
    padding: 0;
    margin: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.details-tile--hoverable:hover {
    border-color: var(--gold);
}

/* Item / spell / mod tooltip (match details), worded like the in-game one. */
.item-tooltip {
    position: absolute;
    width: 340px;
    padding: 10px 14px 12px 14px;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--accent-border);
    background-color: rgba(12, 16, 24, 0.97);
}

.item-tooltip__title {
    padding: 0;
    margin: 0 0 3px 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--gold);
}

.item-tooltip__stats {
    padding: 0;
    margin: 0 0 6px 0;
    font-size: 13px;
    white-space: normal;
    color: rgb(140, 220, 140);
}

.item-tooltip__body {
    padding: 0;
    margin: 0;
    font-size: 14px;
    white-space: normal;
    color: var(--text);
}

/* ---------- Post-match analysis ---------- */

.post-match__title {
    padding: 0;
    margin: 0;
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--gold);
}

.post-match__title--win {
    color: rgb(110, 215, 135);
}

.post-match__title--loss {
    color: rgb(235, 110, 100);
}

.match-details--standalone {
    border-width: 2px;
    border-radius: 8px;
}

.start__message {
    max-width: 520px;
    padding: 10px 14px;
    margin: 0 0 18px 0;
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgb(150, 70, 60);
    background-color: rgb(40, 20, 20);
    color: rgb(240, 150, 140);
}
