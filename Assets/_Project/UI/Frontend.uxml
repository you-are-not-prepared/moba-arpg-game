<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Frontend.uss" />
    <ui:VisualElement name="frontendRoot" class="frontend">
        <ui:VisualElement name="loginScreen" class="screen start hidden">
            <ui:Label class="start__title" text="Project MOBA" />
            <ui:Label class="start__subtitle" text="A MOBA with ARPG builds · prototype" />
            <ui:VisualElement name="loginCard" class="login-card">
                <ui:Label name="loginHeading" class="login__heading" text="Log in" />
                <ui:VisualElement name="loginForm">
                    <ui:Label class="login__label" text="Email or username" />
                    <ui:TextField name="loginName" class="login__field" max-length="254" />
                    <ui:Label class="login__label" text="Password" />
                    <ui:TextField name="loginPassword" class="login__field" password="true" max-length="128" />
                </ui:VisualElement>
                <ui:VisualElement name="registerForm" class="hidden">
                    <ui:Label class="login__label" text="Email" />
                    <ui:TextField name="registerEmail" class="login__field" max-length="254" />
                    <ui:Label class="login__label" text="Username (3–24 letters, numbers, _)" />
                    <ui:TextField name="registerUsername" class="login__field" max-length="24" />
                    <ui:Label class="login__label" text="Password (at least 8 characters)" />
                    <ui:TextField name="registerPassword" class="login__field" password="true" max-length="128" />
                    <ui:Label class="login__label" text="Confirm password" />
                    <ui:TextField name="registerConfirm" class="login__field" password="true" max-length="128" />
                </ui:VisualElement>
                <ui:Label name="loginMessage" class="login__message hidden" />
                <ui:Button name="loginSubmit" class="fe-button fe-button--primary login__submit" text="Log in" />
                <ui:Button name="loginSwitch" class="login__link" text="No account yet? Create one" />
            </ui:VisualElement>
            <ui:Button name="playOfflineButton" class="login__link login__offline" text="Play offline (nothing is saved to an account)" />
        </ui:VisualElement>

        <ui:VisualElement name="startScreen" class="screen start hidden">
            <ui:VisualElement class="account-bar">
                <ui:Label name="accountLabel" class="account-bar__label" />
                <ui:Button name="accountButton" class="login__link account-bar__button" />
            </ui:VisualElement>
            <ui:Label class="start__title" text="Project MOBA" />
            <ui:Label class="start__subtitle" text="A MOBA with ARPG builds · prototype" />

            <ui:VisualElement name="startMenu" class="start__menu">
                <ui:Button name="findMatchButton" class="fe-button fe-button--primary start__button" text="Find a match" />
                <ui:Button name="historyButton" class="fe-button start__button" text="Match history" />
                <ui:Button name="quitButton" class="fe-button start__button" text="Quit" />
            </ui:VisualElement>

            <ui:VisualElement name="modeMenu" class="start__menu hidden">
                <ui:Label class="mode__heading" text="Choose a mode" />
                <ui:VisualElement class="mode__row">
                    <ui:VisualElement name="pveCard" class="mode-card">
                        <ui:Label class="mode-card__title" text="PvE" picking-mode="Ignore" />
                        <ui:Label class="mode-card__text" text="3v3 against bots. Your teammates are bots too; every bot plays a random hero." picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="pvpCard" class="mode-card">
                        <ui:Label class="mode-card__title" text="PvP" picking-mode="Ignore" />
                        <ui:Label class="mode-card__text" text="Against other players. Online play isn't available yet, so this starts a match with no other players." picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="modeBackButton" class="fe-button start__button" text="Back" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="historyScreen" class="screen history hidden">
            <ui:VisualElement class="history__header">
                <ui:VisualElement class="history__heading">
                    <ui:Label class="select__title" text="Match history" />
                    <ui:Label name="historySummary" class="history__summary" />
                </ui:VisualElement>
                <ui:Button name="historyBack" class="fe-button" text="Back" />
            </ui:VisualElement>
            <ui:Label name="historyStatus" class="history__status hidden" />
            <ui:ScrollView name="historyList" class="history__list" />
        </ui:VisualElement>

        <ui:VisualElement name="selectScreen" class="screen select hidden">
            <ui:VisualElement class="select__header">
                <ui:VisualElement class="select__heading">
                    <ui:Label class="select__title" text="Choose your hero" />
                    <ui:Label name="modeLabel" class="select__mode" />
                    <ui:Label class="select__subtitle" text="Your ultimate is locked to R. Buy spells and mods in the shop for Q, W and E." />
                </ui:VisualElement>
                <ui:VisualElement name="mapCard" class="map-card">
                    <ui:VisualElement name="mapPreview" class="map-card__preview" />
                    <ui:VisualElement class="map-card__info">
                        <ui:Label class="map-card__label" text="MAP THIS MATCH" />
                        <ui:Label name="mapName" class="map-card__name" />
                        <ui:Label name="mapDescription" class="map-card__description" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="select__body">
                <ui:VisualElement class="team-column">
                    <ui:Label class="team-column__label team-column__label--ally" text="YOUR TEAM" />
                    <ui:VisualElement name="allyList" />
                </ui:VisualElement>

                <ui:VisualElement class="select__center">
                    <ui:VisualElement name="heroGrid" class="hero-grid" />
                    <ui:VisualElement name="heroDetail" class="hero-detail" />
                </ui:VisualElement>

                <ui:VisualElement class="team-column">
                    <ui:Label class="team-column__label team-column__label--enemy" text="ENEMY TEAM" />
                    <ui:VisualElement name="enemyList" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="select__footer">
                <ui:Button name="backButton" class="fe-button" text="Back" />
                <ui:Label name="selectStatus" class="select__status" />
                <ui:Button name="lockButton" class="fe-button fe-button--primary" text="Lock in" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="itemTooltip" class="item-tooltip hidden" picking-mode="Ignore">
            <ui:Label name="itemTooltipTitle" class="item-tooltip__title" picking-mode="Ignore" />
            <ui:Label name="itemTooltipStats" class="item-tooltip__stats" picking-mode="Ignore" />
            <ui:Label name="itemTooltipBody" class="item-tooltip__body" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
