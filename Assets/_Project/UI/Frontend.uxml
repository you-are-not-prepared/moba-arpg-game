<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Frontend.uss" />
    <ui:VisualElement name="frontendRoot" class="frontend">
        <ui:VisualElement name="startScreen" class="screen start">
            <ui:Label class="start__title" text="Project MOBA" />
            <ui:Label class="start__subtitle" text="A MOBA with ARPG builds · prototype" />

            <ui:VisualElement name="startMenu" class="start__menu">
                <ui:Button name="findMatchButton" class="fe-button fe-button--primary start__button" text="Find a match" />
                <ui:Button name="quitButton" class="fe-button start__button" text="Quit" />
            </ui:VisualElement>

            <ui:VisualElement name="modeMenu" class="start__menu hidden">
                <ui:Label class="mode__heading" text="Choose a mode" />
                <ui:VisualElement class="mode__row">
                    <ui:VisualElement name="pveCard" class="mode-card">
                        <ui:Label class="mode-card__title" text="PvE" picking-mode="Ignore" />
                        <ui:Label class="mode-card__text" text="3v3 against bots. Your teammates are bots too; every bot plays a random hero." picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="pvpCard" class="mode-card">
                        <ui:Label class="mode-card__title" text="PvP" picking-mode="Ignore" />
                        <ui:Label class="mode-card__text" text="Against other players. Online play isn't available yet, so this starts a match with no other players." picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="modeBackButton" class="fe-button start__button" text="Back" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="selectScreen" class="screen select hidden">
            <ui:VisualElement class="select__header">
                <ui:VisualElement class="select__heading">
                    <ui:Label class="select__title" text="Choose your hero" />
                    <ui:Label name="modeLabel" class="select__mode" />
                    <ui:Label class="select__subtitle" text="Your ultimate is locked to R. Buy spells and mods in the shop for Q, W and E." />
                </ui:VisualElement>
                <ui:VisualElement name="mapCard" class="map-card">
                    <ui:VisualElement name="mapPreview" class="map-card__preview" />
                    <ui:VisualElement class="map-card__info">
                        <ui:Label class="map-card__label" text="MAP THIS MATCH" />
                        <ui:Label name="mapName" class="map-card__name" />
                        <ui:Label name="mapDescription" class="map-card__description" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="select__body">
                <ui:VisualElement class="team-column">
                    <ui:Label class="team-column__label team-column__label--ally" text="YOUR TEAM" />
                    <ui:VisualElement name="allyList" />
                </ui:VisualElement>

                <ui:VisualElement class="select__center">
                    <ui:VisualElement name="heroGrid" class="hero-grid" />
                    <ui:VisualElement name="heroDetail" class="hero-detail" />
                </ui:VisualElement>

                <ui:VisualElement class="team-column">
                    <ui:Label class="team-column__label team-column__label--enemy" text="ENEMY TEAM" />
                    <ui:VisualElement name="enemyList" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="select__footer">
                <ui:Button name="backButton" class="fe-button" text="Back" />
                <ui:Label name="selectStatus" class="select__status" />
                <ui:Button name="lockButton" class="fe-button fe-button--primary" text="Lock in" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
