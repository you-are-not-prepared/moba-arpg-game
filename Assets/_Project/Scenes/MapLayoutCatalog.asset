  m_Script: {fileID: 11500000, guid: 2808c66457c14b74f984e8fdf3551cf7, type: 3}
  m_Name: MapLayoutCatalog
  m_EditorClassIdentifier: Assembly-CSharp::Moba.MapLayoutCatalog
  layouts:
  - id: classic
    displayName: Classic
    description: Three lanes (top, middle, bottom) with jungle between them. Two
      towers per lane per team; losing any lane's inner tower exposes the core.
    sceneName: Map_Classic
    blueCore: {x: -48, y: 0, z: -48}
    redCore: {x: 48, y: 0, z: 48}
    lanes:
    - name: Top
      points:
      - {x: -48, y: 0, z: -48}
      - {x: -58, y: 0, z: -30}
      - {x: -58, y: 0, z: 50}
      - {x: -50, y: 0, z: 58}
      - {x: 30, y: 0, z: 58}
      - {x: 48, y: 0, z: 48}
    - name: Mid
      points:
      - {x: -48, y: 0, z: -48}
      - {x: 48, y: 0, z: 48}
    - name: Bot
      points:
      - {x: -48, y: 0, z: -48}
      - {x: -30, y: 0, z: -58}
      - {x: 50, y: 0, z: -58}
      - {x: 58, y: 0, z: -50}
      - {x: 58, y: 0, z: 30}
      - {x: 48, y: 0, z: 48}
  - id: zones
    displayName: Zones
    description: Two lanes bending through four zones and past an open centre. Zone
      modifiers will come later; for now the zones are just terrain.
    sceneName: Map_Zones
    blueCore: {x: -55, y: 0, z: 0}
    redCore: {x: 55, y: 0, z: 0}
    lanes:
    - name: North
      points:
      - {x: -55, y: 0, z: 0}
      - {x: -40, y: 0, z: 22}
      - {x: -18, y: 0, z: 30}
      - {x: 0, y: 0, z: 16}
      - {x: 18, y: 0, z: 30}
      - {x: 40, y: 0, z: 22}
      - {x: 55, y: 0, z: 0}
    - name: South
      points:
      - {x: -55, y: 0, z: 0}
      - {x: -40, y: 0, z: -22}
      - {x: -18, y: 0, z: -30}
      - {x: 0, y: 0, z: -16}
      - {x: 18, y: 0, z: -30}
      - {x: 40, y: 0, z: -22}
      - {x: 55, y: 0, z: 0}
  - id: delve
    displayName: Delve
    description: One lane down a mine shaft to the deep core and back up the other
      side. Rock walls on every side; the fights happen in the tunnel.
    sceneName: Map_Delve
    blueCore: {x: -50, y: 0, z: 50}
    redCore: {x: 50, y: 0, z: 50}
    lanes:
    - name: Shaft
      points:
      - {x: -50, y: 0, z: 50}
      - {x: -32, y: 0, z: 26}
      - {x: -44, y: 0, z: -4}
      - {x: -14, y: 0, z: -44}
      - {x: 0, y: 0, z: -52}
      - {x: 14, y: 0, z: -44}
      - {x: 44, y: 0, z: -4}
      - {x: 32, y: 0, z: 26}
      - {x: 50, y: 0, z: 50}
